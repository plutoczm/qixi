# Copy this file to .env for authorized live credentials.
# For an offline demo, use: python scripts/dev.py --demo
# Start the normal desktop entry for live mode. Mode and source overrides are
# process options. Keep .env and private files outside Git.

# Accommodation
ROLLINGGO_API_KEY=
TUNIU_API_KEY=
# Optional OAuth, when authorized for the hotel capabilities endpoint.
TUNIU_ACCESS_TOKEN=
XUNQI_TUNIU_AUTH_MODE=api_key
# FlyAI candidate discovery uses the installed official CLI by default.
FLYAI_API_KEY=

# Maps and current ride fare
AMAP_API_KEY=
TENCENT_MAP_KEY=
# Optional Tencent WebService signature secret.
TENCENT_MAP_SECRET=
DIDI_MCP_KEY=

# Natural-language query drafting
DEEPSEEK_API_KEY=
